  <button class="lg:hidden w-7 h-4 relative transition duration-500" id="menu-toggle" aria-label="メニュー">
    <span class="bg-black h-[2px] w-7 block absolute top-0 right-0 bar transition duration-500"></span>
    <span class="bg-black h-[2px] w-5 block absolute top-1/2 right-0 bar transition duration-500"></span>
    <span class="bg-black h-[2px] w-3 block absolute top-full right-0 bar transition duration-500"></span>
  </button>
</header>

<script>
  const button = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  const bars = button.querySelectorAll('.bar');

  button.addEventListener('click', () => {
    nav.classList.toggle('opacity-0');
    nav.classList.toggle('invisible');
    nav.classList.toggle('opacity-100');
    nav.classList.toggle('visible');

    // バツ印切り替え
    button.classList.toggle('rotate-360');
    bars[0].classList.toggle('rotate-45');
    bars[0].classList.toggle('!top-2');
    bars[1].classList.toggle('opacity-0');
    bars[2].classList.toggle('-rotate-45');
    bars[2].classList.toggle('!top-2');
    bars[2].classList.toggle('w-7');
  });
</script>