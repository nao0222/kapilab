---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";

// const res = await fetch("https://kapilab.sumika-creative.net/wp-json/wp/v2/", {
//   headers: {
//     "Cache-Control": "no-cache"
//   }
// });
const API_URL =
  (typeof globalThis !== "undefined" && globalThis.PUBLIC_API_URL) || 
  import.meta.env.PUBLIC_API_URL ||
  "";

const POSTS_ENDPOINT = API_URL + "posts";

if (!POSTS_ENDPOINT) {
  throw new Error("API URL is not defined");
}

const res = await fetch(POSTS_ENDPOINT, {
  headers: { "Cache-Control": "no-cache" }
});

// JSON レスポンスチェック
if (!res.ok || !res.headers.get("content-type")?.includes("application/json")) {
  throw new Error(`API fetch failed or returned non-JSON: ${res.status} ${res.statusText}`);
}

const posts = await res.json();


---


<Layout>
	<main class="pt-[64px] lg:pt-[100px]">
		<div class="container mx-auto px-5 lg:px-10 md:py-14 py-8">
			<h1>テスト</h1>
			{
				posts.map((post) => (
					<h2 set:html={post.title.rendered} />
					<p set:html={post.content.rendered} />
				))
			}
		</div>
	</main>
</Layout>
