---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";

import { getPostListWithCategories, getPickupPosts } from "@/lib/postData";
import { formatDateToDotAndWeekday } from '@/utils/date';
import Pagination from "@/components/pagination.astro";
import { stripHtml } from '@/utils/stripHtml';
import { BASE_URL} from '@/utils/config';

// 投稿とカテゴリーデータを取得
const { posts, totalPages, categoryMap } = await getPostListWithCategories();
const pickupPosts = await getPickupPosts();

const currentPage = 1;


// Yoast SEO
const res = await fetch(`${BASE_URL}yoast/v1/get_head?url=${BASE_URL}`);
const yoast = await res.json();
const meta = {
	title: yoast.title || 'カピラボ',
	description: stripHtml(yoast.description || 'カピラボは、Web制作初心者〜中級者向けの情報サイトです。最新技術や便利なノウハウ、実践的なコツを分かりやすく解説し、学びながら楽しめる内容を提供します。'),
	og_title: yoast.og_title || yoast.title,
	og_description: yoast.og_description || yoast.description,
	og_image: yoast.og_image || '/default-og-image.png',
	twitter_title: yoast.twitter_title || yoast.title,
	twitter_description: yoast.twitter_description || yoast.description,
	twitter_image: yoast.twitter_image || '/default-twitter-image.png'
};
---


<Layout {...meta}>
	<main class="pt-[64px] lg:pt-[100px]">
		<div class="container mx-auto px-5 lg:px-10 md:py-14 py-8">
			<ul class="grid md:flex md:gap-x-10 gap-y-8 md:gap-y-0">
				{pickupPosts.map((post) => (
					<li class="w-full md:w-[48.3%]">
						<a href={`/${post.slug}/`} class="group">
							<div class="overflow-hidden rounded-2xl"><img class="w-full transition duration-700 group-hover:scale-105" src={post._embedded['wp:featuredmedia']?.[0]?.source_url ?? ''} alt={post.title.rendered}></div>
							<div class="flex font-bold text-sm mt-4 transition duration-500 group-hover:text-[#FE2F8C]">
								<p class="">{formatDateToDotAndWeekday(post.date)}</p>
								<p class="ml-[35px]">{post.categories.map((catId) => categoryMap.get(catId)).join(" / ")}</p>
							</div>
							<h3 class="text-lg md:text-2xl mt-2 font-bold leading-relaxed transition duration-500 group-hover:text-[#FE2F8C]">{post.title.rendered}</h3>
						</a>
					</li>
				))}
			</ul>
			<ul class="gap-y-6 md:gap-y-10 md:gap-x-[5.6%] lg:gap-x-[2%] mt-10 grid md:flex md:flex-wrap">
				{posts.map((post:any) => (
					<li class="md:w-[47.2%] lg:w-[32%]">
						<a href={`/${post.slug}/`} class="group">
							<div class="flex relative">
								<p class="text-[#999] text-xs rotate-90 absolute -top-[7px] left-[7px] origin-left">{formatDateToDotAndWeekday(post.date)}</p>
								<div class="overflow-hidden rounded-2xl w-full ml-6"><img class="w-full transition duration-700 group-hover:scale-105" src={post._embedded["wp:featuredmedia"]?.[0]?.source_url ?? ""} alt={post.title.rendered}></div>
							</div>
							<div class="border border-black mr-6 p-5 rounded-2xl -mt-10 z-10 relative bg-[#F5F3EE] transition duration-500 group-hover:text-[#FE2F8C]">
								<p class="font-bold text-sm">{post.categories.map((catId) => categoryMap.get(catId)).join(" / ")}</p>
								<h3 class="font-bold mt-2">{post.title.rendered}</h3>
							</div>
						</a>
					</li>
				))}
			</ul>

			<Pagination currentPage={currentPage} totalPages={totalPages} basePath="" />

		</div>

	</main>
</Layout>
