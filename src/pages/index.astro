---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";

const res = await fetch("https://kapilab.sumika-creative.net/wp-json/wp/v2/posts", {
  headers: {
    "User-Agent": "Mozilla/5.0 (compatible; AstroSSR/1.0)"
  }
});
const posts = await res.json();


---


<Layout>
	<main class="pt-[64px] lg:pt-[100px]">
		<div class="container mx-auto px-5 lg:px-10 md:py-14 py-8">
			<h1>テスト</h1>
			{
				posts.map((post) => (
					<h2 set:html={post.title.rendered} />
					<p set:html={post.content.rendered} />
				))
			}
		</div>
	</main>
</Layout>
