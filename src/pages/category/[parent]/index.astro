---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Pagination from "@/components/pagination.astro";

import { getPaginatedPostsByCategory } from "@/lib/postData";
import { formatDateToDotAndWeekday } from '@/utils/date';
import { getCategories } from "@/lib/wp";
import { stripHtml } from "@/utils/stripHtml";
import { BASE_URL } from "@/utils/config";


export async function getStaticPaths() {
  const categories = await getCategories();
  const parents = categories.filter(cat => !cat.parent);

  const paths = [];

  for (const parent of parents) {
    const { totalPages } = await getPaginatedPostsByCategory(parent.slug, 1);

    for (let page = 1; page <= totalPages; page++) {
      paths.push({
        params: {
          parent: parent.slug,
          page: page.toString()
        }
      });
    }
  }

  return paths;
}

const { parent } = Astro.params;
const currentPage = 1;

const categories = await getCategories();
const categoryObj = categories.find(cat => cat.slug === parent);
if (!categoryObj) throw new Error(`Category '${parent}' not found`);
const categoryName = categoryObj.name;

const { posts, totalPages, categoryMap } = await getPaginatedPostsByCategory(parent, currentPage);


// YoastSEO 情報を取得
const res = await fetch(`${BASE_URL}categories/${categoryObj.id}?_fields=id,name,slug,yoast_head_json`);
const categoryDetail = await res.json();
const yoast = categoryDetail.yoast_head_json || {};
const meta = {
  title: stripHtml(yoast.title) || `${categoryObj.name} の記事一覧`,
  description: stripHtml(yoast.description) || `${categoryObj.name} に関する記事まとめ`,
  og_title: stripHtml(yoast.og_title) || categoryObj.name,
  og_description: stripHtml(yoast.og_description) || `${categoryObj.name} の記事一覧`,
  og_image: yoast.og_image || [],
  twitter_title: stripHtml(yoast.twitter_title) || categoryObj.name,
  twitter_description: stripHtml(yoast.twitter_description) || `${categoryObj.name} の記事一覧`,
  twitter_image: yoast.twitter_image || []
};

---


<Layout {...meta}>
	<main class="pt-[64px] lg:pt-[100px]">
		<div class="container mx-auto px-5 lg:px-10 md:py-14 py-8">
			<h2 class="text-2xl font-bold">{categoryName}の記事一覧</h2>
			<ul class="gap-y-6 md:gap-y-10 md:gap-x-[5.6%] lg:gap-x-[2%] mt-10 grid md:flex md:flex-wrap">
				{posts.map((post:any) => (
					<li class="md:w-[47.2%] lg:w-[32%]">
						<a href={`/${post.slug}/`} class="group">
							<div class="flex relative">
								<p class="text-[#999] text-xs rotate-90 absolute -top-[7px] left-[7px] origin-left">{formatDateToDotAndWeekday(post.date)}</p>
								<div class="overflow-hidden rounded-2xl w-full ml-6"><img class="w-full transition duration-700 group-hover:scale-105" src={post._embedded["wp:featuredmedia"]?.[0]?.source_url ?? ""} alt={post.title.rendered}></div>
							</div>
							<div class="border border-black mr-6 p-5 rounded-2xl -mt-10 z-10 relative bg-[#F5F3EE] transition duration-500 group-hover:text-[#FE2F8C]">
								<p class="font-bold text-sm">{post.categories.map((catId) => categoryMap.get(catId)).join(" / ")}</p>
								<h3 class="font-bold mt-2">{post.title.rendered}</h3>
							</div>
						</a>
					</li>
				))}
			</ul>

			<Pagination currentPage={currentPage} totalPages={totalPages} basePath={`/category/${parent}`} />
		</div>

	</main>
</Layout>
