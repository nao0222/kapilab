---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";

import { getPages, getPageBySlug } from "@/lib/wp";
import { formatDateToDotAndWeekday } from '@/utils/date';

export async function getStaticPaths() {
  const pages = await getPages();
  // console.log('pages:', pages);
  return pages.map(page => ({
    params: { slug: page.slug }
  }));
}

const { slug } = Astro.params;
const post = await getPageBySlug(slug);

if (!post) {
  throw new Error(`Page not found: ${slug}`);
}

// 投稿者IDを取得
const authorId = post.author;
// 投稿者情報を別リクエストで取得（ACF含む）
const authorRes = await fetch(`${import.meta.env.PUBLIC_API_URL}users/${authorId}`);
const author = await authorRes.json();

const authorData = post._embedded?.author?.[0] || {};
const authorName = authorData.name || '名無し';
const authorProfile = authorData.description || '';
const authorAvatar = authorData.avatar_urls?.['96'] || '';
const authorX = author.acf?.x || '';
const authorInstagram = author.acf?.instagram || '';

---


<Layout>
	<main class="pt-[64px] lg:pt-[100px]">
    <div class="border-b">
        <div class="container mx-auto px-5 lg:px-10 md:py-14 py-8 flex flex-wrap justify-between items-center">
            <div class="w-full md:w-[50%] order-2 md:order-1">
                <div class="text-xs md:text-sm text-[#888] font-medium flex space-x-5 md:space-x-10 mt-2 md:mt-0">
                    <p>{formatDateToDotAndWeekday(post.date)}</p>
                    <p>{post._embedded?.['wp:term']?.[0]?.map(cat => cat.name) || []}</p>
                </div>
                <h1 class="mt-3 md:mt-6 text-xl lg:text-3xl font-bold leading-normal">{post.title.rendered}</h1>
                <div class="mt-3 md:mt-5 flex space-x-2 md:space-x-3 items-center">
                    <div class="overflow-hidden rounded-full"><img class="w-[30px] md:w-[42px]" src={authorAvatar} alt={authorName}></div>
                    <p class="font-bold text-sm md:text-base">{authorName}</p>
                </div>
            </div>
            <div class="w-full md:w-[43.4%] order-1 md:order-2">
                <div class="overflow-hidden rounded-2xl"><img class="w-full" src={post._embedded?.['wp:featuredmedia']?.[0]?.source_url || ''} alt={post.title.rendered}></div>
            </div>
        </div>
    </div>
    <div class="container mx-auto px-5 lg:px-10 md:py-14 py-8 flex flex-wrap">
      <article class="w-full lg:w-[65%]">
        <div set:html={post.content.rendered}></div>
      </article>
    </div>
  </main>
</Layout>
