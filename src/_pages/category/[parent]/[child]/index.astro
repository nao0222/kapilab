---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Pagination from "@/components/pagination.astro";

import { getPaginatedPostsByCategory } from "@/lib/postData";
import { formatDateToDotAndWeekday } from '@/utils/date';
import { getCategories } from "@/lib/wp";

export async function getStaticPaths() {
  const categories = await getCategories();
  const children = categories.filter(cat => cat.parent);

  const paths = children.map(child => {
    const parent = categories.find(cat => cat.id === child.parent);
    return {
      params: { parent: parent.slug, child: child.slug }
    };
  });

  return paths;
}

const { parent, child } = Astro.params;
const currentPage = 1;

const categories = await getCategories();
const categoryObj = categories.find(cat => cat.slug === child);
if (!categoryObj) throw new Error(`Category '${child}' not found`);
const categoryName = categoryObj.name;

const { posts, totalPages, categoryMap } = await getPaginatedPostsByCategory(child, currentPage);
---


<Layout>
	<main class="pt-[64px] lg:pt-[100px]">
		<div class="container mx-auto px-5 lg:px-10 md:py-14 py-8">
			<h2 class="text-2xl font-bold">{categoryName}の記事一覧</h2>
			<ul class="gap-y-6 md:gap-y-10 md:gap-x-[5.6%] lg:gap-x-[2%] mt-10 grid md:flex md:flex-wrap">
				{posts.map((post:any) => (
					<li class="md:w-[47.2%] lg:w-[32%]">
						<a href={`/${post.slug}`} class="group">
							<div class="flex relative">
								<p class="text-[#999] text-xs rotate-90 absolute -top-[7px] left-[7px] origin-left">{formatDateToDotAndWeekday(post.date)}</p>
								<div class="overflow-hidden rounded-2xl w-full ml-6"><img class="w-full transition duration-700 group-hover:scale-105" src={post._embedded["wp:featuredmedia"]?.[0]?.source_url ?? ""} alt={post.title.rendered}></div>
							</div>
							<div class="border-1 border-black mr-6 p-5 rounded-2xl -mt-10 z-10 relative bg-[#F5F3EE] transition duration-500 group-hover:text-[#FE2F8C]">
								<p class="font-bold text-sm">{post.categories.map((catId) => categoryMap.get(catId)).join(" / ")}</p>
								<h3 class="font-bold mt-2">{post.title.rendered}</h3>
							</div>
						</a>
					</li>
				))}
			</ul>
			<Pagination currentPage={currentPage} totalPages={totalPages} basePath={`/category/${parent}/${child}`} />
		</div>

	</main>
</Layout>
